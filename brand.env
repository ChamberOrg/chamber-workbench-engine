# DSH_CLIENT_TITLE is baked into the engine web UI at Vite build time.
# Researchers never see this file; `chamber workbench` launches the result
# as a hidden child (or CHAMBER_WORKBENCH_ENGINE points at the binary).
DSH_CLIENT_TITLE=Chamber
DSH_TELEMETRY_DISABLED=1
UPSTREAM_REPO=https://github.com/deepseek-ai/deepseek-harness.git
UPSTREAM_REF=0.1.0-rc.8
ENGINE_BIN_NAME=chamber-workbench-engine
# Live fork lives in a separate GitHub repo, not this monorepo.
FORK_GITHUB_ORG=ChamberOrg
FORK_REPO_NAME=chamber-workbench-engine
